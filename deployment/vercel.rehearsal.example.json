{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend --include=dev",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "https://REPLACE-RENDER-SERVICE.onrender.com/api/$1",
      "headers": {
        "Cache-Control": "private, no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-tallynest-proxy-secret"
          },
          "args": "$PROXY_SHARED_SECRET",
          "env": ["PROXY_SHARED_SECRET"]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "methods": ["GET", "HEAD"],
      "dest": "/index.html"
    }
  ]
}
