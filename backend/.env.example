NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_finance_manager
CLIENT_ORIGIN=http://localhost:5173
# Generate 32 random bytes as 64 hexadecimal characters (see README).
JWT_SECRET=
JWT_TTL_SECONDS=900

# Only for the reviewed Vercel -> Render two-hop topology. Leave both unset locally.
# Generate independently from JWT_SECRET; never put this in VITE_* variables.
# PROXY_SHARED_SECRET=
# TRUST_PROXY_HOPS=2

# Temporary private IP-chain verification only; omit both normally.
# Independent random 64-hex token, never the ingress or JWT secret.
# Deadline may be at most 15 minutes ahead at startup; expired windows stay silent.
# PROXY_IP_DIAGNOSTIC_TOKEN=
# PROXY_IP_DIAGNOSTIC_UNTIL=<ISO-8601-UTC-deadline>
